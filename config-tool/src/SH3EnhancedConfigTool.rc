#include <windows.h>
#include <commctrl.h>
#include "resource.h"

IDI_CONFIG_TOOL ICON "../assets/halo-of-the-sun.ico"

IDD_MAIN DIALOGEX 0, 0, 357, 298
STYLE DS_SETFONT | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_THICKFRAME
CAPTION "Silent Hill 3 Enhanced Configuration Tool"
FONT 9, "Segoe UI"
BEGIN
    CONTROL "", IDC_TABS, WC_TABCONTROL, WS_TABSTOP, 2, 2, 353, 218
    LTEXT "Help", IDC_HELP_TITLE, 5, 223, 346, 10
    CONTROL "", IDC_HELP_RULE, "Static", SS_ETCHEDHORZ, 5, 236, 346, 1
    LTEXT "Hover over a setting or its label to see what it does.", IDC_HELP_BODY, 5, 240, 346, 40
    DEFPUSHBUTTON "Close", IDC_CLOSE, 4, 283, 37, 11
    PUSHBUTTON "Default", IDC_DEFAULTS, 44, 283, 48, 11
    LTEXT "Game to launch:", IDC_LAUNCH_LABEL, 121, 285, 62, 10, SS_CENTERIMAGE
    COMBOBOX IDC_LAUNCH_EXE, 158, 283, 54, 48, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "...", IDC_BROWSE_EXE, 218, 283, 13, 11
    PUSHBUTTON "Save", IDC_SAVE, 235, 283, 31, 11
    PUSHBUTTON "Save & Launch Game", IDC_SAVE_LAUNCH, 273, 283, 72, 11
END

IDD_DISPLAY_PAGE DIALOGEX 0, 0, 353, 206
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI"
BEGIN
    GROUPBOX "Display", -1, 4, 4, 167, 71
    LTEXT "Window mode", IDC_LABEL_WINDOW_MODE, 9, 14, 49, 10, SS_CENTERIMAGE | SS_NOTIFY
    COMBOBOX IDC_WINDOW_MODE, 61, 13, 99, 43, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Output res.", IDC_LABEL_OUTPUT_RES, 9, 28, 49, 10, SS_CENTERIMAGE | SS_NOTIFY
    EDITTEXT IDC_RESOLUTION_X, 61, 27, 35, 10, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "x", -1, 97, 28, 7, 10, SS_CENTER
    EDITTEXT IDC_RESOLUTION_Y, 105, 27, 35, 10, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Render res.", IDC_LABEL_RENDER_RES, 9, 42, 49, 10, SS_CENTERIMAGE | SS_NOTIFY
    EDITTEXT IDC_RENDER_X, 61, 42, 35, 10, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "x", -1, 97, 42, 7, 10, SS_CENTER
    EDITTEXT IDC_RENDER_Y, 105, 42, 35, 10, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP

    GROUPBOX "Window", -1, 4, 80, 167, 40
    LTEXT "Window size", IDC_LABEL_WINDOW_SIZE, 9, 91, 49, 10, SS_CENTERIMAGE | SS_NOTIFY
    EDITTEXT IDC_WINDOWED_WIDTH, 61, 90, 35, 10, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "x", -1, 97, 91, 7, 10, SS_CENTER
    EDITTEXT IDC_WINDOWED_HEIGHT, 105, 90, 35, 10, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP

    GROUPBOX "Performance", -1, 179, 4, 167, 49
    LTEXT "Frame rate", IDC_LABEL_FRAME_RATE, 183, 14, 49, 10, SS_CENTERIMAGE | SS_NOTIFY
    COMBOBOX IDC_FRAME_RATE, 235, 13, 99, 43, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX "Mirror Room 30 FPS cap", IDC_MIRROR_ROOM_FIX, 183, 31, 155, 10, WS_TABSTOP
    GROUPBOX "Fullscreen Media", -1, 179, 57, 167, 45
    LTEXT "FMV aspect", IDC_LABEL_FMV_ASPECT, 183, 68, 49, 10, SS_CENTERIMAGE | SS_NOTIFY
    COMBOBOX IDC_FMV_MODE, 235, 67, 99, 43, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX "Remove cutscene borders", IDC_REMOVE_CUTSCENE_BORDERS, 183, 82, 147, 10, WS_TABSTOP
    GROUPBOX "Pause menu", -1, 179, 109, 167, 28
    AUTOCHECKBOX "Fullscreen pause menu", IDC_FULLSCREEN_PAUSE, 183, 118, 147, 10, WS_TABSTOP
END

IDD_GRAPHICS_PAGE DIALOGEX 0, 0, 353, 206
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI"
BEGIN
    GROUPBOX "Render Targets", -1, 4, 4, 167, 80
    LTEXT "DoF resolution", IDC_LABEL_DOF_RES, 9, 14, 65, 10, SS_CENTERIMAGE | SS_NOTIFY
    EDITTEXT IDC_DOF_RES, 77, 13, 38, 10, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Shadow map res.", IDC_LABEL_SHADOW_RES, 9, 28, 65, 10, SS_CENTERIMAGE | SS_NOTIFY
    EDITTEXT IDC_SHADOW_RES, 77, 27, 38, 10, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Inventory bg.", IDC_LABEL_INVENTORY_RES, 9, 42, 65, 10, SS_CENTERIMAGE | SS_NOTIFY
    EDITTEXT IDC_INVENTORY_RES, 77, 41, 38, 10, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Status image", IDC_LABEL_STATUS_RES, 9, 56, 65, 10, SS_CENTERIMAGE | SS_NOTIFY
    EDITTEXT IDC_STATUS_RES, 77, 54, 38, 10, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP

    GROUPBOX "Rendering", -1, 179, 4, 167, 67
    LTEXT "Fog complexity", IDC_LABEL_FOG, 183, 14, 65, 10, SS_CENTERIMAGE | SS_NOTIFY
    EDITTEXT IDC_FOG_COMPLEXITY, 251, 13, 38, 10, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    AUTOCHECKBOX "Anisotropic texture filtering", IDC_ANISOTROPIC, 183, 29, 147, 10, WS_TABSTOP
    AUTOCHECKBOX "Disable MSAA for depth of field", IDC_DISABLE_MSAA_DOF, 183, 43, 156, 10, WS_TABSTOP
    GROUPBOX "Fonts", -1, 179, 76, 167, 43
    LTEXT "Font quality", IDC_LABEL_FONT_SCALE, 183, 88, 49, 10, SS_CENTERIMAGE | SS_NOTIFY
    COMBOBOX IDC_FONT_SCALE, 235, 87, 99, 46, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
END

IDD_SYSTEM_PAGE DIALOGEX 0, 0, 353, 206
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI"
BEGIN
    GROUPBOX "Compatibility", -1, 4, 4, 167, 72
    AUTOCHECKBOX "Registry redirect", IDC_REGISTRY_REDIRECT, 9, 14, 147, 10, WS_TABSTOP
    AUTOCHECKBOX "Disable safe-mode reset", IDC_DISABLE_SAFE_MODE, 9, 28, 147, 10, WS_TABSTOP
    AUTOCHECKBOX "White border fix", IDC_WHITE_BORDER, 9, 42, 147, 10, WS_TABSTOP
    AUTOCHECKBOX "Muted audio recovery", IDC_FIX_MUTED_AUDIO, 9, 56, 153, 10, WS_TABSTOP
    GROUPBOX "Control Options", -1, 4, 83, 167, 62
    LTEXT "Icon style", -1, 9, 96, 53, 10, SS_CENTERIMAGE
    COMBOBOX IDC_BUTTON_ICON_STYLE, 64, 95, 99, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    GROUPBOX "Performance", -1, 179, 4, 167, 34
    LTEXT "CPU mask", IDC_LABEL_CPU_MASK, 183, 14, 58, 10, SS_CENTERIMAGE | SS_NOTIFY
    EDITTEXT IDC_CPU_AFFINITY, 245, 13, 49, 10, ES_AUTOHSCROLL | WS_TABSTOP
    GROUPBOX "Diagnostics", -1, 179, 42, 167, 45
    AUTOCHECKBOX "Write crash minidumps", IDC_EXCEPTION_HANDLER, 183, 54, 147, 10, WS_TABSTOP
    AUTOCHECKBOX "Write SH3Enhanced.log", IDC_ENABLE_LOGGING, 183, 68, 147, 10, WS_TABSTOP
    GROUPBOX "Discord", -1, 179, 93, 167, 39
    AUTOCHECKBOX "Enable Rich Presence", IDC_ENABLE_RICH_PRESENCE, 183, 105, 147, 10, WS_TABSTOP
END

IDD_CONTENT_PAGE DIALOGEX 0, 0, 353, 206
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI"
BEGIN
    GROUPBOX "Text Fixes (English)", -1, 4, 4, 167, 59
    AUTOCHECKBOX "Hope House -> Wish House", IDC_FIX_WISH_HOUSE, 9, 14, 147, 10, WS_TABSTOP
    AUTOCHECKBOX "English typo fixes", IDC_FIX_TYPOS, 9, 28, 147, 10, WS_TABSTOP
    AUTOCHECKBOX "Restore missing sewer text", IDC_RESTORE_SEWER_TEXT, 9, 42, 147, 10, WS_TABSTOP
    GROUPBOX "Unlocks", -1, 179, 4, 167, 34
    AUTOCHECKBOX "Silent Hill 2 references", IDC_UNLOCK_SH2, 183, 14, 147, 10, WS_TABSTOP
    GROUPBOX "Audio", -1, 4, 70, 342, 38
    AUTOCHECKBOX "Enable Silent Hill 3 Audio Enhancement Pack", IDC_ENABLE_AUDIO_PACK, 9, 82, 300, 10, WS_TABSTOP
    GROUPBOX "PS2-exclusive costumes", -1, 4, 114, 342, 38
    AUTOCHECKBOX "Enable the fourteen media outlet costumes", IDC_ENABLE_PS2_COSTUMES, 9, 126, 300, 10, WS_TABSTOP
END
